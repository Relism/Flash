<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.relism</groupId>
    <artifactId>flash-parent</artifactId>
    <version>3.0.3</version>
    <packaging>pom</packaging>

    <name>Flash</name>
    <description>An HTTP/1.1 and HTTP/2 server and routing library for Java 21.</description>
    <url>https://github.com/Relism/Flash</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Relism</id>
            <url>https://github.com/Relism</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/Relism/Flash</url>
        <connection>scm:git:https://github.com/Relism/Flash.git</connection>
        <developerConnection>scm:git:https://github.com/Relism/Flash.git</developerConnection>
    </scm>

    <modules>
        <module>flash</module>
        <module>flash-testing</module>
        <module>flash-extensions</module>
    </modules>

    <properties>
        <!-- surefire skips the real-client tests unless the interop profile clears it -->
        <excludedGroups>interop</excludedGroups>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lombok.version>1.18.48</lombok.version>
        <slf4j.version>2.0.20</slf4j.version>
        <maven.javadoc.plugin.version>3.12.0</maven.javadoc.plugin.version>
        <maven.source.plugin.version>3.4.0</maven.source.plugin.version>
        <maven.gpg.plugin.version>3.2.8</maven.gpg.plugin.version>
        <maven.versions.plugin.version>2.23.0</maven.versions.plugin.version>
        <jmh.version>1.37</jmh.version>
        <junit.version>6.1.3</junit.version>
        <caffeine.version>3.3.1</caffeine.version>
        <micrometer.version>1.17.1</micrometer.version>
        <jakarta.validation.version>3.1.1</jakarta.validation.version>
        <hibernate.validator.version>9.1.5.Final</hibernate.validator.version>
        <expressly.version>6.0.0</expressly.version>
        <avaje.validator.version>2.18</avaje.validator.version>
        <avaje.jsonb.version>3.16</avaje.jsonb.version>
        <protobuf.version>4.36.2</protobuf.version>
        <grpc.version>1.84.3</grpc.version>
        <protovalidate.version>1.3.0</protovalidate.version>
        <build.helper.plugin.version>3.6.2</build.helper.plugin.version>
        <maven.compiler.plugin.version>3.16.0</maven.compiler.plugin.version>
    </properties>

    <repositories>
        <!-- FastPathRouter (fpr-core) is published only through JitPack -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!--
              Every module of this build, so anything composing Flash imports this POM once and
              never names a version again. An extension left out here is one a consumer has to
              pin by hand, which is how two versions of Flash end up on one classpath.
            -->
